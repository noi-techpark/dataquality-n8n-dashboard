VITE_METADATA_URL=https://tourism.api.opendatahub.testingmachine.eu/v1/MetaData?pagesize=1000&origin=interactive-dashboard
VITE_N8N_WEBHOOK_URL=https://backend.n8n.opendatahub.testingmachine.eu/webhook/data-quality-dashboard
VITE_CACHE_API_URL=https://backend.n8n.opendatahub.testingmachine.eu/webhook/analysis-cache
VITE_CACHE_WRITE_URL=https://backend.n8n.opendatahub.testingmachine.eu/webhook/cache-write
VITE_PAGE_SIZE=1000

# Keycloak Configuration
VITE_KEYCLOAK_URL=https://auth.opendatahub.testingmachine.eu/auth
VITE_KEYCLOAK_REALM=noi

# Leave empty to auto-detect based on current domain (works for both local and production)
VITE_KEYCLOAK_REDIRECT_URI=
VITE_KEYCLOAK_CLIENT_ID=n8n

# Base Path (e.g. /dashboard/ or /) - NOT the full URL
VITE_BASE_PATH=/
